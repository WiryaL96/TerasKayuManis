# Install as /etc/teraskayumanis/backup.env, root:root 0600.
# Use a dedicated DB backup login with read access to public, tkm, auth, storage.
# pg_dump must match or exceed the server major version. Require verified TLS.
BACKUP_DATABASE_URL=postgresql://BACKUP_USER:PRIVATE_PASSWORD@POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/etc/teraskayumanis/prod-ca-2021.crt
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PRIVATE_SERVER_ONLY
BACKUP_BUCKET=RESTAURANT_PRIVATE_BUCKET
BACKUP_AWS_ACCOUNT=RESTAURANT_12_DIGIT_ACCOUNT
AWS_DEFAULT_REGION=ap-southeast-3
BACKUP_STATUS_PATH=/var/lib/teraskayumanis-backups/status.json
