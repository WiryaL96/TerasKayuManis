# Go reads process environment; it does not automatically load this file.
APP_ENV=development
## Vercel strips Git metadata from source uploads; retain deployment provenance via Git SHA.
GOFLAGS=-buildvcs=false
HOST=127.0.0.1
PORT=8080
# Optional in development: empty => /ready responds 503.
# Use a restricted runtime PostgreSQL role, not migration/admin credentials.
DATABASE_URL=
# Supabase Auth verifies cashier Bearer tokens, never service_role here
SUPABASE_URL=https://aiptdjypuccoakyfvdyl.supabase.co
SUPABASE_ANON_KEY=
# Exact comma-separated browser origins; empty disables WebSocket + dispatcher.
# Local Caddy example: http://127.0.0.1:5594
REALTIME_ORIGINS=
# Vercel sets VERCEL=1. Use the transaction pooler for autoscaled Go functions;
# Vercel mode disables prepared statements and uses at most 2 connections/instance.
# Set HOST=0.0.0.0 on Vercel. Keep secrets server-only and shared with Nuxt.
TKM_PROXY_SECRET=
CRON_SECRET=
