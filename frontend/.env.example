# Go backend for cash-only menu/order/cashier proxy (server-side URL)
NUXT_GO_API_URL=http://127.0.0.1:8080
# Transitional Nitro server credentials (server only)
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_KEY=
# Browser auth: public URL and publishable/anon key ONLY. Never service_role.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_SITE_URL=http://127.0.0.1:3000

# Private, stable random secret (32+ characters). Keep it with deployment secrets.
NUXT_CASHIER_PIN_SECRET=
# Vercel: NUXT_SERVERLESS=true, NUXT_PUBLIC_SYNC_MODE=polling.
# Same private value as the Go project's TKM_PROXY_SECRET (32+ random characters).
NUXT_BACKEND_PROXY_SECRET=
